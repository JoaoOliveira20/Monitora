# Ambiente de execução: "development" ou "production".
# O Dockerfile força "production" na imagem de produção; pode deixar como está.
NODE_ENV=development

# Nome exibido no log de inicialização e no comando /status.
# Se vazio, usa "Monitora".
MONITOR_NAME=

# Caminho do arquivo de configuração de targets, dentro do container/processo.
# Opcional — se vazio, usa o padrão "config/targets.json" relativo ao diretório de execução.
# Só faz sentido mudar se você quiser apontar para um arquivo em outro lugar.
MONITORA_CONFIG_PATH=

# URL do webhook do Discord usado pelos targets que referenciam esta variável
# em "discordWebhookEnv" (ver config/targets.example.json). O nome não é fixo —
# você pode ter várias variáveis DISCORD_WEBHOOK_* com nomes diferentes, uma por
# canal/uso, desde que o nome bata com o "discordWebhookEnv" do target.
# NUNCA compartilhe esse valor — a URL do webhook contém um token secreto.
DISCORD_WEBHOOK_MAIN=

# Reservada — não usada por nenhum código hoje. Pode deixar em branco.
DISCORD_WEBHOOK_URL=

# Credenciais do Bot do Discord (comando /status). Opcionais: sem elas, o
# Monitora roda normalmente, só sem o bot. Veja o passo a passo no README.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# Opcional. Se definida, o /status é registrado só nesse servidor (instantâneo).
# Se vazia, é registrado globalmente (pode levar até ~1h para propagar).
DISCORD_GUILD_ID=
