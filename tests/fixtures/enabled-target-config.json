{
  "version": 1,
  "defaults": {
    "intervalSeconds": 60,
    "timeoutMs": 5000,
    "failureThreshold": 2,
    "recoveryThreshold": 1,
    "cooldownSeconds": 900
  },
  "targets": [
    {
      "id": "internal-api",
      "name": "Internal API",
      "type": "http",
      "enabled": true,
      "urlEnv": "TARGET_INTERNAL_API_URL_TEST",
      "discordWebhookEnv": "DISCORD_WEBHOOK_MAIN_TEST"
    }
  ]
}
